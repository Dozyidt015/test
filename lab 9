#include <iostream>
using namespace std;

int main()
{
	int matrix_1[100][100];
	int matrix_2[100][100];
	int matrix_sum[100][100];
	int rows, cols;

	do {
		system("cls");
		cout << "Enter number of rows: "; cin >> rows;
	} while (rows <= 0 || rows > 100);

	do {
		cout << "Enter number of columns: "; cin >> cols;
	} while (cols <= 0 || cols > 100);

	cout << "Enter elements in matrix 1: ";
	for (int i = 0; i < rows; i++) {
		for (int j = 0; j < cols; j++) {
			cin >> matrix_1[i][j];
		}
	}

	cout << "Enter elements in matrix 2: ";
	for (int i = 0; i < rows; i++) {
		for (int j = 0; j < cols; j++) {
			cin >> matrix_2[i][j];
		}
	}

	cout << "The elements in Matrix 1 are: " << endl;
	for (int i = 0; i < rows; i++) {
		for (int j = 0; j < cols; j++) {
			cout << matrix_1[i][j] << " ";
		}
		cout << endl;
	}

	cout << "The elements in Matrix 2 are: " << endl;
	for (int i = 0; i < rows; i++) {
		for (int j = 0; j < cols; j++) {
			cout << matrix_2[i][j] << " ";
		}
		cout << endl;
	}

	cout << "The sum of the two matrices is: " << endl;
	for (int i = 0; i < rows; i++) {
		for (int j = 0; j < cols; j++) {
			matrix_sum[i][j] = matrix_1[i][j] + matrix_2[i][j];
			cout << matrix_sum[i][j] << " ";
		}
		cout << endl;
	}
}
