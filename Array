#include <iostream>
#include <algorithm>
using namespace std;

int main()
{
	int arr[5];
	for (int i = 0; i < 5; i++) {
		cout << "Enter a number: ";
		cin >> arr[i];
	}

	for (int i = 0; i < 5; i++) {
		cout << "You entered: " << arr[i] << endl;
	}

	cout << endl;

	sort(arr, arr + 5);

	int max = arr[0];
	int min = arr[0];

	for (int i = 1; i < 5; i++) {
		if (arr[i] > max) {
			max = arr[i];
		}
	}
	cout << "The maximum number is: " << max << endl;

	for (int i = 1; i > 5; i++) {
		if (arr[i] > min) {
			min = arr[i];
		}
	}
	cout << "The minimum number is: " << min << endl;
		
}
