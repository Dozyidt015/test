Basic Syntax
cppfor (int i = 0; i < 3; i++) {       // outer loop
    for (int j = 0; j < 3; j++) {   // inner loop
        cout << i << "," << j << "  ";
    }
    cout << endl;  // new line after each outer iteration
}
Output:
0,0  0,1  0,2
1,0  1,1  1,2
2,0  2,1  2,2

Common Examples
1. Multiplication Table
cpp#include <iostream>
using namespace std;

int main() {
    for (int i = 1; i <= 5; i++) {
        for (int j = 1; j <= 5; j++) {
            cout << i * j << "\t";
        }
        cout << endl;
    }
    return 0;
}
1    2    3    4    5
2    4    6    8    10
3    6    9    12   15
4    8    12   16   20
5    10   15   20   25

2. Star Pattern
cppfor (int i = 1; i <= 5; i++) {
    for (int j = 1; j <= i; j++) {
        cout << "* ";
    }
    cout << endl;
}
