#include <iostream>
using namespace std;

// the constant to define the maximus size
const int MAX_SIZE = 100;

int main()
{   
	// vairables used
	int size = 0, sumeven = 0, sumodd = 0;
	int n[MAX_SIZE];

	cout << "Add Even/Odd Arrays" << endl;

	do { // the loop used to check the size of the array
		cout << "Number of items to sort: ";
		cin >> size;
	} while (size < 1 || size > MAX_SIZE);


	// used to input the elements and calculate the sums
	for (int i = 0; i < size; i++) { 
		cout << "Enter elements " << i + 1 << ": ";
		cin >> n[i];
		if (n[i] % 2 == 0) { // check the element if it is even and add it to the sum of even elements
			sumeven += n[i];
		} else {            // if the element is odd, add it to the sum of odd elements
			sumodd += n[i];
		}
	}

	// used to display even elements
	cout << "\nEven elements\n";
	for (int i = 0; i < size; i++) { 
		if (n[i] % 2 == 0) {
			cout << n[i] << " ";
		}
	}

	// used to display odd elements
	cout << "\n\nOdd elements\n";
	for (int i = 0; i < size; i++) { 
		if (n[i] % 2 != 0) {
			cout << n[i] << " ";
		}
	}

	// display the sums of even and odd elements
	cout << "\n\nSum of even elements: " << sumeven << endl;
	cout << "\nSum of odd elements: " << sumodd << endl;

	return 0;
}
